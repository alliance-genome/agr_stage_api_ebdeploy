Resources:
  AccessLogsBucket:
    Type: AWS::S3::Bucket
    Properties:
      BucketName: alliance-stage-api-alb-logs-20260503
      LifecycleConfiguration:
        Rules:
          - Id: ExpireAfter1Year
            Status: Enabled
            ExpirationInDays: 365
      Tags:
        - {Key: Team, Value: shared}
        - {Key: Project, Value: public-website}
        - {Key: AppComponent, Value: shared}
        - {Key: Product, Value: public-website}
        - {Key: DeploymentEnvironment, Value: stage}

  AccessLogsBucketPolicy:
    Type: AWS::S3::BucketPolicy
    Properties:
      Bucket:
        Ref: AccessLogsBucket
      PolicyDocument:
        Version: '2012-10-17'
        Statement:
          # us-east-1 ELB log-delivery account that writes the gzipped access logs
          - Sid: ELBAccessLogsWrite
            Effect: Allow
            Principal:
              AWS: arn:aws:iam::127311923021:root
            Action: s3:PutObject
            Resource:
              Fn::Sub: '${AccessLogsBucket.Arn}/stage-api/AWSLogs/${AWS::AccountId}/*'

  AWSEBV2LoadBalancer:
    Type: AWS::ElasticLoadBalancingV2::LoadBalancer
    DependsOn: AccessLogsBucketPolicy

option_settings:
  aws:elbv2:loadbalancer:
    AccessLogsS3Enabled: 'true'
    AccessLogsS3Bucket: alliance-stage-api-alb-logs-20260503
    AccessLogsS3Prefix: stage-api
